<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- D-09：排除 SQL Server 驱动栈，见 Directory.Build.targets。 -->
    <ExcludeSqlServerDriverStack>true</ExcludeSqlServerDriverStack>
    <!--
      雪花 ID 时间戳的构建时间下限（总设计 §10.1：时间戳不早于本版本的构建时间）。
      为保持确定性构建不读取构建机时钟，取固定值，随版本发布更新；构建时可用同名属性覆盖。
    -->
    <TenonEdgeBuildTimestampFloor Condition="'$(TenonEdgeBuildTimestampFloor)' == ''">2026-09-30T00:00:00Z</TenonEdgeBuildTimestampFloor>
    <!--
      首版发布目标 linux-x64（总设计 §12 T5，T0-13 自包含最小发布）：还原时一并解析该平台相关的 NuGet 资产并写入锁文件，
      CI 以 locked mode 还原后发布（后端实施规范 §5）。自包含发布用的运行时包不在锁文件中，版本由 global.json 固定的 SDK 决定。
      不影响普通构建。
    -->
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="TenonEdge.BuildTimestampFloor" Value="$(TenonEdgeBuildTimestampFloor)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SqlSugarCoreNoDrive" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.Bcl.AsyncInterfaces 在 Host 中只被已排除的 Azure.Core 引用，一并排除；
      测试工程中 xUnit 需要它的 6.0 版本，因此只在 Host 中排除，并且不向引用方传递。
    -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TenonEdge.UnitTests" />
    <InternalsVisibleTo Include="TenonEdge.IntegrationTests" />
  </ItemGroup>

</Project>
