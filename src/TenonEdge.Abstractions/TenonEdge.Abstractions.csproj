<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Host 与 Runtime 之间的契约（总设计 §3.2，后端实施规范 §2）：不可变运行计划、运行消息与运行单元接口。
    只依赖 .NET 基础类型，不引用 ASP.NET Core、ORM 或协议库，也不引用任何 NuGet 包（工程规则测试持续检查）。
  -->

  <PropertyGroup>
    <!--
      Host 按 linux-x64 自包含发布时（T0-13），被引用的工程同样按该平台还原；在此声明，使平台相关的还原结果进入本工程的锁文件，
      CI 以 locked mode 还原后发布不会因锁文件缺少该平台而失败（§6 决定 48）。不影响普通构建。
    -->
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

</Project>
