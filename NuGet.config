<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 公开构建只使用 nuget.org，不继承本机或私有包源（后端实施规范 §5）。 -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
