<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)../tenonedge.runsettings</RunSettingsFilePath>
    <!-- 与 Host 相同地排除 SQL Server 驱动栈，测试与发布物使用同一组程序集（见 Directory.Build.targets）。 -->
    <ExcludeSqlServerDriverStack>true</ExcludeSqlServerDriverStack>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/TenonEdge.Abstractions/TenonEdge.Abstractions.csproj" />
    <ProjectReference Include="../../src/TenonEdge.Host/TenonEdge.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
