<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)../tenonedge.runsettings</RunSettingsFilePath>
    <!-- 与 Host 相同地排除 SQL Server 驱动栈，测试与发布物使用同一组程序集（见 Directory.Build.targets）。 -->
    <ExcludeSqlServerDriverStack>true</ExcludeSqlServerDriverStack>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 协议候选库只用于 Probes 目录中的验证代码（T0-11、T0-12），不是正式适配器。 -->
    <PackageReference Include="FluentModbus" />
    <PackageReference Include="MQTTnet" />
    <PackageReference Include="NModbus" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/TenonEdge.Abstractions/TenonEdge.Abstractions.csproj" />
    <ProjectReference Include="../../src/TenonEdge.Host/TenonEdge.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- T0-11 测试 Broker 的配置，测试运行时复制进容器。 -->
    <None Update="Probes/Mqtt/mosquitto.conf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
