<Project>
  <!--
    NuGet 版本集中管理（后端实施规范 §5）。
    工程只写 PackageReference 名称，不写版本；版本变化须连同 packages.lock.json 与验证证据一起提交。
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Host">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- 配置库：SqlSugarCoreNoDrive 不带 SQLite 驱动，由 Host 显式引用 Microsoft.Data.Sqlite（总设计 §2.3）。 -->
    <PackageVersion Include="SqlSugarCoreNoDrive" Version="5.1.4.221" />
  </ItemGroup>

  <!-- Host（config.db）与 Runtime（queue.db）使用同一版本的 Microsoft.Data.Sqlite，加载同一个原生库（V-07）。 -->
  <ItemGroup Label="Sqlite">
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <!-- Runtime 的日志抽象，版本与宿主使用的 ASP.NET Core 共享框架 10.0.12 一致。 -->
  <ItemGroup Label="Runtime">
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <!--
    D-09（未确认前按推荐方案）：SqlSugarCoreNoDrive 经 SystemCommon 带入的 SQL Server 驱动栈。
    下列包只为排除资产而直接引用（见 Directory.Build.targets 的 ExcludeSqlServerDriverStack），不进入构建输出和发布物；
    版本与 SqlSugarCoreNoDrive 5.1.4.221 的依赖解析结果一致。它们仍在还原图和锁文件中，漏洞审计照常覆盖。
  -->
  <ItemGroup Label="SqlServerDriverStack">
    <PackageVersion Include="Azure.Core" Version="1.38.0" />
    <PackageVersion Include="Azure.Identity" Version="1.11.4" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="1.1.1" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageVersion Include="Microsoft.Data.SqlClient.SNI.runtime" Version="5.2.0" />
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.61.3" />
    <PackageVersion Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.61.3" />
    <PackageVersion Include="Microsoft.IdentityModel.Abstractions" Version="7.6.3" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="7.6.3" />
    <PackageVersion Include="Microsoft.IdentityModel.Logging" Version="7.6.3" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols" Version="6.35.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="6.35.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="7.6.3" />
    <PackageVersion Include="Microsoft.SqlServer.Server" Version="1.0.0" />
    <PackageVersion Include="System.ClientModel" Version="1.0.0" />
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="7.6.3" />
    <PackageVersion Include="System.Memory.Data" Version="1.0.2" />
    <PackageVersion Include="System.Runtime.Caching" Version="8.0.0" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageVersion Include="SystemCommon" Version="8.5.0" />
  </ItemGroup>

  <!--
    协议候选库（T0-11 MQTT 最小原型、T0-12 Modbus 候选库比较）：MQTTnet 已用于正式 MQTT 适配，NModbus 3.0.83 已获 T2-02 采用确认；FluentModbus 仅由验证代码引用；
    正式适配器在 T1、T2 按验证结论选定后由 Adapters 引用（依赖规则禁止 Runtime 与 Abstractions 引用协议库）。
    版本不低于总设计 §2.3 的要求，来源与许可见 docs/reference-notes.md §4。
  -->
  <ItemGroup Label="ProtocolProbes">
    <PackageVersion Include="FluentModbus" Version="5.3.2" />
    <PackageVersion Include="MQTTnet" Version="5.2.0.1603" />
    <PackageVersion Include="NModbus" Version="3.0.83" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- 可控时钟（FakeTimeProvider）：周期、退避与截止时间的测试不依赖真实等待（后端实施规范 §6.1）。 -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- 只走 VSTest：使用关闭 Microsoft Testing Platform 的 xUnit.net v3 包，避免混入第二套运行器。 -->
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>
