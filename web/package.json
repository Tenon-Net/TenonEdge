{
  "name": "@tenonedge/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.21.0",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=11.21.0 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run licenses && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api:generate": "node scripts/export-openapi.mjs",
    "api:check": "node scripts/export-openapi.mjs --check",
    "licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-label": "2.1.16",
    "@radix-ui/react-slot": "1.4.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.14",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "26.4.2",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-i18next": "17.0.16",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.1",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.87.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
